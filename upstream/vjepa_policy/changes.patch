-    # registry spec (stride 4), and raw clips such as the 17-frame stride-2
-    # experiment are intentionally not divisible by that VAE ratio.
-    tubelet_size = 1
-    temporal_mode = "causal_stride"
-    num_views = None
-    patches_per_step = WAN22_PATCHES_PER_STEP
