+        proprio=None,
+        proprio_projector=None,
+        all_actions_mask=None,
+        noisy_action_features=None,
+        timestep_embeddings=None,
+        use_film: bool = False,
+        jepa_primary=None,
+        jepa_wrist=None,
+        noisy_future=None,
+        future_time=None,
+        future_dropped=None,
+        **loss_kwargs,
+    ) -> Union[Tuple, DreamVLModelOutput]:
+        r"""
+        Args:
+            labels (`torch.LongTensor` of shape `(batch_size, sequence_length)`, *optional*):
+                Labels for computing the masked language modeling loss. Indices should either be in `[0, ...,
+                config.vocab_size]` or -100 (see `input_ids` docstring). Tokens with indices set to `-100` are ignored
+                (masked), the loss is only computed for the tokens with labels in `[0, ..., config.vocab_size]`.
+        Returns:
+        Example:
+        ```python
+        >>> from PIL import Image
+        >>> import requests
+        >>> from transformers import AutoProcessor, DreamVLForConditionalGeneration
+        >>> model = DreamVLForConditionalGeneration.from_pretrained(" ")
+        >>> processor = AutoProcessor.from_pretrained(" ")
+        >>> messages = [
+            {
+                "role": "user",
+                "content": [
+                    {"type": "image"},
+                    {"type": "text", "text": "What is shown in this image?"},
+                ],
+            },
+        ]
+        >>> url = "https://www.ilankelman.org/stopsigns/australia.jpg"
+        >>> image = Image.open(requests.get(url, stream=True).raw)
+        >>> text = processor.apply_chat_template(messages, tokenize=False, add_generation_prompt=True)
+        >>> inputs = processor(text=[text], images=[image], vision_infos=[vision_infos])
+        >>> # Generate
+        >>> generate_ids = model.generate(inputs.input_ids, max_length=30)
+        >>> tokenizer.batch_decode(generate_ids, skip_special_tokens=True, clean_up_tokenization_spaces=False)[0]
+        "The image shows a street scene with a red stop sign in the foreground. In the background, there is a large red gate with Chinese characters ..."
+        ```"""
+
+        output_attentions = output_attentions if output_attentions is not None else self.config.output_attentions
+        output_hidden_states = (
+            output_hidden_states if output_hidden_states is not None else self.config.output_hidden_states
+        )
+        return_dict = return_dict if return_dict is not None else self.config.use_return_dict
+
+        # Get text & visual features
+        if inputs_embeds is None:
+            inputs_embeds = self.get_input_embeddings()(input_ids)
+            if pixel_values is not None:
+                image_embeds = self.get_image_features(pixel_values, image_grid_thw)
+                image_embeds = torch.cat(image_embeds, dim=0)
+                n_image_tokens = (input_ids == self.config.image_token_id).sum()
+                n_image_features = image_embeds.shape[0]
+                if not is_torchdynamo_compiling() and n_image_tokens != n_image_features:
+                    raise ValueError(
+                        f"Image features and image tokens do not match: tokens: {n_image_tokens}, features {n_image_features}"
+                    )
+
+                mask = input_ids == self.config.image_token_id
+                mask_unsqueezed = mask.unsqueeze(-1)
+                mask_expanded = mask_unsqueezed.expand_as(inputs_embeds)
+
+                image_mask = mask_expanded.to(inputs_embeds.device)
+                image_embeds = image_embeds.to(inputs_embeds.device, inputs_embeds.dtype)
+                image_embeds_projected = self.projector(image_embeds)
+
+                inputs_embeds = inputs_embeds.masked_scatter(image_mask, image_embeds_projected)
+
+            if pixel_values_videos is not None:
+                video_embeds = self.get_video_features(pixel_values_videos, video_grid_thw)
+                video_embeds = torch.cat(video_embeds, dim=0)
+                n_video_tokens = (input_ids == self.config.video_token_id).sum()
+                n_video_features = video_embeds.shape[0]
+                if not is_torchdynamo_compiling() and n_video_tokens != n_video_features:
+                    raise ValueError(
+                        f"Video features and video tokens do not match: tokens: {n_video_tokens}, features {n_video_features}"
+                    )
+
+                mask = input_ids == self.config.video_token_id
+                mask_unsqueezed = mask.unsqueeze(-1)
+                mask_expanded = mask_unsqueezed.expand_as(inputs_embeds)
+
+                video_mask = mask_expanded.to(inputs_embeds.device)
+                video_embeds = video_embeds.to(inputs_embeds.device, inputs_embeds.dtype)
+                video_embeds_projected = self.projector(video_embeds)
+                
+                inputs_embeds = inputs_embeds.masked_scatter(video_mask, video_embeds_projected)
+        
+        if noisy_action_features is not None:
+            # Replace embeddings of the action tokens with noisy action embeddings
+            inputs_embeds = replace_input_embeddings(
+                inputs_embeds, all_actions_mask, noisy_action_features
+            )
+            # [Diffusion] Add diffusion timestep embedding if provided
+            # For simplicity, just prepend diffusion timestep embedding
+            if timestep_embeddings is not None:
+                inputs_embeds = torch.cat((timestep_embeddings, inputs_embeds), dim=1)
+                attention_mask = torch.cat(
+                    (torch.ones((attention_mask.shape[0], 1), device=attention_mask.device, dtype=attention_mask.dtype), attention_mask), dim=1
+                )
+
+        if proprio_projector is not None and proprio is not None:
+            # proprio: (bsz, proprio_dim) or (propro_dim,)
+            proprio_features = proprio_projector(proprio)  # (bsz, llm_dim)
+            proprio_features = proprio_features.unsqueeze(dim=1)  # (bsz, 1, llm_dim)
+            # For simplicity, just append proprio token to the end of projected vision patch tokens
+            inputs_embeds = torch.cat((proprio_features, inputs_embeds), dim=1)
+            attention_mask = torch.cat(
+                (torch.ones((attention_mask.shape[0], 1), device=attention_mask.device, dtype=attention_mask.dtype), attention_mask), dim=1
+            )
+        original_length = inputs_embeds.shape[1]
+        joint = jepa_primary is not None
+        if joint:
+            from .jepa_tokens import joint_attention_mask
+            if self.config._attn_implementation != "sdpa" or output_attentions:
+                raise ValueError("Joint JEPA uses SDPA with explicit information mask")
+            if past_key_values is not None or use_cache:
+                raise ValueError("Joint flow recomputes all tokens; KV cache must be disabled")
+            current, future = self.jepa_tokens(jepa_primary, jepa_wrist, noisy_future)
+            future_t = self.jepa_time(future_time.float()).unsqueeze(1)
+            extra = torch.cat([current, future_t, future], dim=1).to(inputs_embeds.dtype)
+            inputs_embeds = torch.cat([inputs_embeds, extra], dim=1)
+            attention_mask = torch.cat([attention_mask, attention_mask.new_ones((extra.shape[0], extra.shape[1]))], dim=1)
+            position_ids = attention_mask.cumsum(dim=1)
+            future_start = original_length + 32
+            attention_mask = joint_attention_mask(attention_mask, future_start, future_dropped)
+        else:
+            position_ids = attention_mask.cumsum(dim=1)
+        outputs = self.model(
+            attention_mask=attention_mask,
+            position_ids=position_ids,
+            past_key_values=past_key_values,
+            inputs_embeds=inputs_embeds,
+            use_cache=use_cache,
+            output_attentions=output_attentions,
+            output_hidden_states=output_hidden_states,
+            return_dict=return_dict,
+            cache_position=cache_position,
+        )
+
+        hidden_states = outputs[0]
+        future_velocity = None
+        if joint:
+            future_velocity = self.jepa_future_head(hidden_states[:, future_start + 1:])
+            hidden_states = hidden_states[:, :original_length]
+            inputs_embeds = inputs_embeds[:, :original_length]
+        if proprio_projector is not None and proprio is not None:
+            # Remove the proprio embedding before computing logits and loss
+            hidden_states = hidden_states[:, 1:, :]
+            inputs_embeds = inputs_embeds[:, 1:, :]
+        if timestep_embeddings is not None:
+            # Remove the diffusion timestep embedding before computing logits and loss
+            hidden_states = hidden_states[:, 1:, :]
+            inputs_embeds = inputs_embeds[:, 1:, :]
+            
+        # Only compute necessary logits, and do not upcast them to float if we are not computing the loss
+        logits = self.lm_head(hidden_states[:, -num_logits_to_keep:, :])
+
+        loss = None
+        if labels is not None:
+            loss = self.loss_function(logits, labels, self.vocab_size, **loss_kwargs)
+
+        if not return_dict:
+            output = (logits,) + outputs[1:]
+            return (loss,) + output if loss is not None else output
+
+        return DreamVLModelOutput(
+            future_velocity=future_velocity,
+            logits=logits,
+            loss=loss,
+            past_key_values=outputs.past_key_values,
+            hidden_states=hidden_states,
+            attentions=outputs.attentions,
+            rope_deltas=rope_deltas,
+            inputs_embeds=inputs_embeds,
+            attention_mask=attention_mask
+        )
+
+    def prepare_inputs_for_generation(
+        self,
+        input_ids,
+        past_key_values=None,
+        attention_mask=None,
+        inputs_embeds=None,
+        cache_position=None,
+        position_ids=None,
+        use_cache=True,
+        pixel_values=None,
+        pixel_values_videos=None,
+        image_grid_thw=None,
+        video_grid_thw=None,
+        rope_deltas = None,
+        proprio=None,
+        proprio_projector=None,
+        all_actions_mask=None,
+        noisy_action_features=None,
+        timestep_embeddings=None,
+        **kwargs,
+    ):
+        # never remove input ids
+
+        if use_cache:
+            if past_key_values is None:
+                raise ValueError(
+                    "If `use_cache=True`, `past_key_values` must be provided. Please make sure to pass `past_key_values` to the model."
+                )
+            else:
+                pass
+        else:
+            past_key_values = None
+
+        if use_cache:
+            if cache_position is None:
+                raise ValueError(
+                    "If `use_cache=True`, `cache_position` must be provided. Please make sure to pass `cache_position` to the model."
+                )
+            else:
+                pass
+        else:
+            cache_position = None
+
+        if use_cache:
+            if input_ids.shape[1] != cache_position.shape[0]:
+                input_ids = input_ids[:, cache_position]
+            else:
+                pass
+        else:
+            pass
+
+        if position_ids is None:
+            if not use_cache:
+                position_ids, rope_deltas = self.get_rope_index(
+                    input_ids, image_grid_thw, video_grid_thw, attention_mask
+                )
+            else:
+                if cache_position[0] == 0:
+                    position_ids, rope_deltas = self.get_rope_index(
+                        input_ids, image_grid_thw, video_grid_thw, attention_mask
+                    )
+                else:
+                    batch_size, seq_length = input_ids.shape
+                    delta = (
+                        cache_position[0] + rope_deltas if cache_position is not None and rope_deltas is not None else 0
+                    )
+                    position_ids = torch.arange(seq_length, device=input_ids.device)
+                    position_ids = position_ids.view(1, -1).expand(batch_size, -1)
+                    position_ids = position_ids.add(delta)
+                    position_ids = position_ids.unsqueeze(0).expand(3, -1, -1)
+    
+        else:
+            raise NotImplementedError(
+                "position_ids is not None, please check the code in prepare_inputs_for_generation"
+            )
+
+        if use_cache:
+            if cache_position[0] != 0:
+                pixel_values = None
+                pixel_values_videos = None
+                logger.debug(f"after prefill, the pixel_values and pixel_values_videos are None.")
+        else:
+            pass
+
+        # if `inputs_embeds` are passed, we only want to use them in the 1st generation step
+        # if inputs_embeds is not None:
+        #     raise NotImplementedError(
+        #         "inputs_embeds is not None, please check the code in prepare_inputs_for_generation"
+        #     )
+        # else:
+        #     model_inputs = {"input_ids": input_ids, "inputs_embeds": None}
+
+        model_inputs = {
+                "input_ids": input_ids, 
+                "inputs_embeds": inputs_embeds,
+                "position_ids": position_ids,
+                "past_key_values": past_key_values,
+                "use_cache": use_cache,
+                "attention_mask": attention_mask,
+                "pixel_values": pixel_values,
+                "pixel_values_videos": pixel_values_videos,
+                "image_grid_thw": image_grid_thw,
+                "video_grid_thw": video_grid_thw,
+                "cache_position": cache_position,
+                "rope_deltas": rope_deltas,
+                "proprio": proprio,
+                "proprio_projector": proprio_projector,
+                "all_actions_mask": all_actions_mask,
+                "noisy_action_features": noisy_action_features,
+                "timestep_embeddings": timestep_embeddings,
+            }
+        return model_inputs
+
