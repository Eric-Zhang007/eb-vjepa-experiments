+def decode_video_frames_pyav(video_path, timestamps, tolerance_s):
+    """Native PyAV RGB decoding without torchvision's removed VideoReader API."""
+    queries = torch.as_tensor(timestamps, dtype=torch.float64)
+    if queries.ndim != 1 or not queries.numel() or not torch.isfinite(queries).all():
+        raise ValueError("Expected a nonempty finite timestamp vector")
+    if tolerance_s < 0 or queries.min() < 0:
+        raise ValueError("Timestamps and tolerance must be nonnegative")
+    frames, times = [], []
+    with av.open(str(video_path)) as container:
+        stream = container.streams.video[0]
+        stream.thread_type = "AUTO"
+        container.seek(int(max(0, queries.min().item() - tolerance_s) / float(stream.time_base)),
+                       stream=stream, backward=True, any_frame=False)
+        for frame in container.decode(stream):
+            if frame.time is None:
+                raise RuntimeError(f"Missing frame timestamp: {video_path}")
+            frames.append(torch.from_numpy(frame.to_ndarray(format="rgb24")).permute(2, 0, 1))
+            times.append(float(frame.time))
+            if times[-1] >= queries.max().item():
+                break
+    if not frames:
+        raise RuntimeError(f"No decoded video frames: {video_path}")
+    pts = torch.tensor(times, dtype=torch.float64)
+    if not torch.all(pts[1:] >= pts[:-1]):
+        raise RuntimeError(f"Nonmonotonic frame timestamps: {video_path}")
+    right = torch.searchsorted(pts, queries).clamp(max=len(pts) - 1)
+    left = (right - 1).clamp(min=0)
+    chosen = torch.where((pts[left] - queries).abs() <= (pts[right] - queries).abs(), left, right)
+    error = (pts[chosen] - queries).abs()
+    if torch.any(error > tolerance_s):
+        raise ValueError(f"Video timestamp mismatch {error.max().item():.6f}s: {video_path}")
+    return torch.stack([frames[i] for i in chosen.tolist()]).float().div_(255)
+
