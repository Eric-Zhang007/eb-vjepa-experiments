-    target_ids = token_ids[context_steps:].reshape(-1)
-    return SimpleNamespace(
-        ctx_idx=context_ids,
-        tgt_idx=target_ids,
-        n_ctx=context_ids.numel(),
-        grid_depth=grid_depth,
-        num_views=num_views,
-    )
