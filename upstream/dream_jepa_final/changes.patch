+        if cfg.resume_checkpoint:
+            resume_wandb_id = torch.load(Path(cfg.resume_checkpoint) / "training_rank_0.pt", map_location="cpu", weights_only=False)["progress"]["wandb_id"]
+        logged_config = json.loads(json.dumps(asdict(cfg), default=str))
+        logged_config.update(world_size=dist.get_world_size(),
+            global_batch_size=cfg.batch_size * cfg.grad_accumulation_steps * dist.get_world_size())
+        (Path(run_dir)/"resolved_config.json").write_text(json.dumps(logged_config, indent=2))
+        # Resume-only switches differ while the actual training contract stays fixed.
