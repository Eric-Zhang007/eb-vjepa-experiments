-def _normalize_int_sequence(value, name):
-    if value is None:
-        return None
-    try:
-        values = tuple(int(item) for item in value)
-    except (TypeError, ValueError) as error:
-        raise ValueError(f"{name} must be an integer sequence") from error
-    return values
