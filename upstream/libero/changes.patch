+        y_ranges=[(0, 0)],
+        rotation=None,
+        rotation_axis="z",
+        ensure_object_boundary_in_range=True,
+        ensure_valid_placement=True,
+        reference_pos=(0, 0, 0),
+        z_offset=0.0,
+    ):
