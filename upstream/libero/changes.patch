+
+def get_xy_region_kwargs_list_from_regions_info(regions_info_dict):
+    kwargs_list = []
+    for k, v in regions_info_dict.items():
+        assert type(v) is dict
+        kwargs = {
+            "region_name": k,
+        }
+        kwargs.update(v)
+        kwargs_list.append(kwargs)
