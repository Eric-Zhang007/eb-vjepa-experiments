+            )
+        else:
+            self.patch_embed = PatchEmbed(
+                patch_size=patch_size, in_chans=in_chans, embed_dim=embed_dim
+            )
+            self.num_patches = (img_size[0] // patch_size) * (img_size[1] // patch_size)
+
+        if self.img_temporal_dim_size is not None:
