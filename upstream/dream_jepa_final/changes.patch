+def get_current_action_mask(token_ids, action_dim=7):
+    # Create a tensor marking positions of IGNORE_INDEX
+    newline_positions = token_ids != -100
+
+    # Calculate cumulative sum to identify regions between newlines
+    cumsum = torch.cumsum(newline_positions, dim=1)
+
+    # Create the mask
+    mask = (1 <= cumsum) & (cumsum <= action_dim)
+
+    # Extract the action part only
+    action_tokens_only_mask = token_ids > ACTION_TOKEN_BEGIN_IDX
+    mask = action_tokens_only_mask * mask
+
+    return mask
+
+
+def get_next_actions_mask(token_ids, action_dim=7):
+    # Create a tensor marking positions of IGNORE_INDEX
+    newline_positions = token_ids != -100
+
+    # Calculate cumulative sum to identify regions between newlines
+    cumsum = torch.cumsum(newline_positions, dim=1)
+
+    # Create the mask
+    mask = cumsum > action_dim
+
+    # Extract the action part only
+    action_tokens_only_mask = token_ids > ACTION_TOKEN_BEGIN_IDX
+    mask = action_tokens_only_mask * mask
+
+    return mask
+
+def process_action_masks(labels, action_dim=7):
+    """Helper to get action masks from labels"""
+    current_action_mask = get_current_action_mask(labels, action_dim=action_dim)
+    next_actions_mask = get_next_actions_mask(labels,  action_dim=action_dim)
+    all_actions_mask = current_action_mask | next_actions_mask  # (B, seq_len)
+    return all_actions_mask
+    
+class DreamVLAForActionPrediction(DreamVLModel):
+    config_class: PretrainedConfig = DreamVLAConfig
+
+    def __init__(self, config: DreamVLAConfig) -> None:
+        super().__init__(config)
+        self.norm_stats = config.norm_stats
+
+        # Compute action bins
+        self.bins = np.linspace(-1, 1, config.n_action_bins)
+        self.bin_centers = (self.bins[:-1] + self.bins[1:]) / 2.0
+
+    def _run_diffusion_prediction(
+        self,
+        input_ids,
+        all_actions_mask,
+        noise,
+        action_head,
+        labels,
+        noisy_action_projector,
+        action_dim,
+        action_chunk,
+        **kwargs
+    ):
+        """Run diffusion-based action prediction"""
+        # Clone embedding for reuse in each timestep
+        curr_noisy_actions = noise
+        inputs_embeds = None
+        # action_head.noise_scheduler.set_timesteps(num_inference_steps=50)
+        # print(action_head.noise_scheduler.timesteps)
+        # Reverse diffusion: Iteratively denoise to generate action prediction
+        for t in action_head.noise_scheduler.timesteps:
+            # Get diffusion model's noise prediction (conditioned on VLA latent embedding, current noisy action
+            # embedding, and diffusion timestep embedding)
+            timesteps = torch.Tensor([t]).to(labels.device)
+            timestep_embeddings = (
+                action_head.time_encoder(timesteps).to(curr_noisy_actions.dtype).to(curr_noisy_actions.device)
+            )  # (B, llm_dim)
+            timestep_embeddings = timestep_embeddings.unsqueeze(1)  # (B, 1, llm_dim)
+
+            # Reshape and project noisy actions into language embedding space
+            B = curr_noisy_actions.shape[0]
+            orig_curr_noisy_actions_shape = curr_noisy_actions.shape
+            curr_noisy_actions = curr_noisy_actions.reshape(B, -1).unsqueeze(-1)
+            noisy_action_features = noisy_action_projector(curr_noisy_actions)
+            curr_noisy_actions = curr_noisy_actions.reshape(orig_curr_noisy_actions_shape)
+
+            # Forward pass through language model
+            if inputs_embeds is None: 
+                output = self(
+                    input_ids=input_ids,
+                    noisy_action_features=noisy_action_features,
+                    all_actions_mask=all_actions_mask,
+                    timestep_embeddings=timestep_embeddings,
+                    return_dict=True,
+                    **kwargs
+                ) 
+            else:
+                output = self(
+                    inputs_embeds=inputs_embeds, 
+                    noisy_action_features=noisy_action_features,
+                    all_actions_mask=all_actions_mask,
+                    timestep_embeddings=timestep_embeddings,
+                    return_dict=True,
+                    **kwargs
+                )
+            # Extract hidden states for action portion of response
+            last_hidden_states = output.hidden_states[:, :-1, :]  # (B, seq_len, D), ignore the last one
+            actions_hidden_states = last_hidden_states[
+                :,
+                -(action_dim * action_chunk + 2): -2,
+                :,
+            ]  # (B, act_chunk_len, D)
+
+            # Predict noise and update noisy actions: x_t -> x_{t-1}
+            noise_pred = action_head.predict_noise(actions_hidden_states)
+            curr_noisy_actions = action_head.noise_scheduler.step(noise_pred, t, curr_noisy_actions).prev_sample
+
+        curr_noisy_actions = curr_noisy_actions.reshape(action_chunk, action_dim)
+
+        # Return final actions
+        return curr_noisy_actions.float().cpu().detach().numpy(), actions_hidden_states
+
+
+    def _regression_or_discrete_prediction(
+        self,
+        input_ids,
+        all_actions_mask,
+        action_head,
+        labels,
+        action_dim,
+        action_chunk,
+        vocab_size,
+        noisy_action_features,
+        ignore_end_tokens=2,
+        **kwargs
+    ):
+        """Run L1 regression-based continuous action prediction or discrete action tokens prediction."""
+        # Zero out action token embeddings
+        output = self(
+            input_ids=input_ids,
+            noisy_action_features=noisy_action_features,
+            all_actions_mask=all_actions_mask,
+            return_dict=True,
+            **kwargs
+        )
+
+        # Extract hidden states for action portion of response
+        last_hidden_states = output.hidden_states[:, :-1, :]  # (B, seq_len, D), ignore the last one
+        if ignore_end_tokens > 0:
+            actions_hidden_states = last_hidden_states[
+                :,
+                -(action_dim * action_chunk + ignore_end_tokens): -ignore_end_tokens,
+                :,
+            ]  # (B, act_chunk_len, D)
+        else:
+            actions_hidden_states = last_hidden_states[:,-(action_dim * action_chunk):,:,]  # (B, act_chunk_len, D)
+
+        # Handle different prediction methods
+        if action_head is not None:
+            # L1 regression prediction
+            normalized_actions = action_head.predict_action(actions_hidden_states)
+            normalized_actions = normalized_actions.reshape(action_chunk, action_dim)
+            normalized_actions = normalized_actions.float().cpu().detach().numpy()
+        else:
+            # Discrete token-based prediction
+            # predicted_action_token_ids = (
+            #     output.logits[
+            #         :,
+            #         -(action_dim * action_chunk + ignore_end_tokens+1): -(ignore_end_tokens+1),
+            #     ]
+            #     .argmax(dim=-1)
+            #     .cpu()
+            #     .numpy()
+            # )
+            # Extract logits
+            logits_slice = output.logits[
+                :,
+                -(action_dim * action_chunk + ignore_end_tokens + 1): -(ignore_end_tokens + 1),
+            ]
+            # Sample with temperature
+            predicted_action_token_ids = sample_with_temperature(
+                logits_slice, 
+                temperature=kwargs['temperature']
+            ).cpu().numpy()
+
+            discretized_actions = vocab_size - predicted_action_token_ids
+            discretized_actions = np.clip(discretized_actions - 1, a_min=0, a_max=self.bin_centers.shape[0] - 1)
+            normalized_actions = self.bin_centers[discretized_actions]
+            normalized_actions = normalized_actions.reshape(action_chunk, action_dim)
+
+        return normalized_actions, actions_hidden_states
+
+
+    def _flow_matching_prediction(
+        self,
+        input_ids,
+        all_actions_mask,
+        action_head,
+        noisy_action_projector,
+        action_dim,
+        action_chunk,
+        steps=1, 
+        **kwargs
+    ):
+        """
+        Samples actions by integrating the flow field from noise to the target distribution.
+        """
+        batch_size = input_ids.shape[0]
+        device = input_ids.device
+        curr_noisy_actions = action_head.sample_noise((batch_size, action_chunk, action_dim), device)
+        inputs_embeds = None
+        # Discretize the flow into num_steps
+        dt = 1.0 / steps
+        # print(steps)
+        # Start from t=0 and move backward to t=1
+        time = torch.tensor(0.0, dtype=torch.bfloat16, device=device)
+        while time < 1:
+            # Current timestep in [0, 1]
+            timesteps = time.expand(batch_size)
+            timestep_embeddings = (
+                action_head.time_encoder(timesteps).to(curr_noisy_actions.dtype).to(curr_noisy_actions.device)
+            )  # (B, llm_dim)
+            timestep_embeddings = timestep_embeddings.unsqueeze(1)  # (B, 1, llm_dim)
+
+            # Reshape and project noisy actions into language embedding space
+            B = curr_noisy_actions.shape[0]
+            orig_curr_noisy_actions_shape = curr_noisy_actions.shape
+            curr_noisy_actions = curr_noisy_actions.reshape(B, -1).unsqueeze(-1)
+            noisy_action_features = noisy_action_projector(curr_noisy_actions)
+            curr_noisy_actions = curr_noisy_actions.reshape(orig_curr_noisy_actions_shape)
+
+            # Forward pass through language model
+            if inputs_embeds is None: 
+                output = self(
+                    input_ids=input_ids,
+                    noisy_action_features=noisy_action_features,
+                    all_actions_mask=all_actions_mask,
+                    timestep_embeddings=timestep_embeddings,
+                    return_dict=True,
+                    **kwargs
+                ) 
+            else:
+                output = self(
+                    inputs_embeds=inputs_embeds, 
+                    noisy_action_features=noisy_action_features,
+                    all_actions_mask=all_actions_mask,
+                    timestep_embeddings=timestep_embeddings,
+                    return_dict=True,
+                    **kwargs
+                )
+            # Extract hidden states for action portion of response
+            last_hidden_states = output.hidden_states[:, :-1, :]  # (B, seq_len, D), ignore the last one
+            actions_hidden_states = last_hidden_states[
+                :,
+                -(action_dim * action_chunk + 2): -2,
+                :,
+            ]  # (B, act_chunk_len, D)
+
+            volocity_pred = action_head.predict_velocity(actions_hidden_states)
+            curr_noisy_actions += volocity_pred*dt
+            time += dt
+
+        curr_noisy_actions = curr_noisy_actions.reshape(action_chunk, action_dim)
+
+        # Return final actions
+        return curr_noisy_actions.float().cpu().detach().numpy(), actions_hidden_states
+    
+
+    def _prepare_input_for_action_prediction(self, input_ids, attention_mask, action_dim, action_chunk):
+        """Prepares input for action prediction by adding necessary tokens"""
+        # Add (ACTION_DIM * NUM_ACTIONS_CHUNK) placeholder tokens to input_ids to simulate action tokens
+        placeholder_action_token_ids = (
+            torch.full((input_ids.shape[0], action_dim * action_chunk), ACTION_TOKEN_BEGIN_IDX+1).to(input_ids.device).to(input_ids.dtype)
+        )
+        # NOTE: hard-coded the chat template suffix tokens, need to be changed if the tokenizer is changed
+        suffix = torch.Tensor([151645, 198]).to(input_ids.device).to(input_ids.dtype).unsqueeze(0).expand(input_ids.shape[0], -1)
+        input_ids = torch.cat([input_ids, placeholder_action_token_ids, suffix], dim=-1)
+
+        # Extend the attention mask to fit the new shape of input
+        # Note: Only batch size == 1 supported right now
+        mask_extension = (
+            torch.ones((attention_mask.shape[0], input_ids.shape[-1] - attention_mask.shape[-1]))
+            .to(attention_mask.device)
+            .to(attention_mask.dtype)
+        )
+        attention_mask = torch.cat([attention_mask, mask_extension], dim=-1)
+
+        return input_ids, attention_mask
+    
+    @torch.no_grad()
+    def predict_action(
+        self, input_ids: Optional[torch.LongTensor] = None, unnorm_key: Optional[str] = None, 
+            action_chunk=1, 
+            action_head = None, 
+            noisy_action_projector=None, 
+            vocab_size=None,
+            use_discrete_diffusion=False,
+            use_flow_matching=False,
+            **kwargs: str
+    ) -> np.ndarray:
+        """Thin wrapper around .diffusion_generate() that decodes predicted actions and unnormalizes them."""
+        # Run VLA inference
+        # print(action_chunk)
+        action_dim = self.get_action_dim(unnorm_key)
+        attention_mask = kwargs.pop('attention_mask')
+        if use_discrete_diffusion:
+            # print("discrete diff run")
+            kwargs['max_new_tokens'] = action_dim * action_chunk + 2
+            # given last 2 end tokens, not affect performance
+            # def x_hook(step, x, logits):
+            #     x[:, -1] = 198
+            #     x[:, -2] = 151645
+            #     return x
+            # outputs = self.diffusion_generate(input_ids, attention_mask=attention_mask, return_dict_in_generate=True, generation_tokens_hook_func=x_hook, **kwargs)
+            outputs = self.diffusion_generate(input_ids, attention_mask=attention_mask, return_dict_in_generate=True, **kwargs)
+            generated_ids = outputs.sequences
+            pred_action_dim = action_dim
+            # Extract predicted action tokens and translate into (normalized) continuous actions, assume batch size = 1
+            predicted_action_token_ids = generated_ids[0, input_ids.shape[1]:].cpu().numpy()
+            discretized_actions =  vocab_size - predicted_action_token_ids[:pred_action_dim*action_chunk]
+            discretized_actions = np.clip(discretized_actions - 1, a_min=0, a_max=self.bin_centers.shape[0] - 1)
+            normalized_actions = self.bin_centers[discretized_actions]
+            normalized_actions = normalized_actions.reshape(-1, pred_action_dim)[:, :action_dim]  # [action_chunk, action_dim]
+            actions = self._unnormalize_actions(normalized_actions, unnorm_key)
+            return actions
+            
+        # append action_dim * action_chunk placeholders to the input_ids and labels
+        labels = input_ids.clone()
+        labels[:] = -100
+        input_ids, _attention_mask = self._prepare_input_for_action_prediction(input_ids, attention_mask, action_dim, action_chunk)
+        labels, _ = self._prepare_input_for_action_prediction(labels, attention_mask, action_dim, action_chunk)
+        attention_mask = _attention_mask
+        
+        all_actions_mask = process_action_masks(labels, action_dim=action_dim)
+
+        # Use diffusion if provided, otherwise use regression or discrete prediction
+        use_diffusion = noisy_action_projector is not None and hasattr(action_head, "noise_scheduler")
+        if use_flow_matching:
+            # Run diffusion-based prediction
+            normalized_actions, actions_hidden_states = self._flow_matching_prediction(
+                input_ids=input_ids,
+                attention_mask=attention_mask,
+                all_actions_mask=all_actions_mask,
+                action_head=action_head,
+                noisy_action_projector=noisy_action_projector,
+                action_dim=action_dim,
+                action_chunk=action_chunk,
+                **kwargs
+            )
+        elif use_diffusion:
+            # Sample random noise with shape equal to output action, used as the starting state for reverse diffusion
+            noise = torch.randn(
+                size=(1, action_chunk, action_dim), device=input_ids.device, dtype=torch.bfloat16
+            )
+
+            # Run diffusion-based prediction
+            normalized_actions, actions_hidden_states = self._run_diffusion_prediction(
+                input_ids=input_ids,
+                attention_mask=attention_mask,
+                all_actions_mask=all_actions_mask,
+                noise=noise,
+                action_head=action_head,
+                labels=labels,
+                noisy_action_projector=noisy_action_projector,
+                action_dim=action_dim,
+                action_chunk=action_chunk,
+                **kwargs
+            )
+        else:
+            inputs_embeds = self.get_input_embeddings()(input_ids)
+            noisy_action_features = torch.zeros_like(inputs_embeds)[:, -action_dim * action_chunk:, :] # (B, chunk*action_dim, D)
+
+            # Run regression or discrete token-based prediction
+            normalized_actions, actions_hidden_states = self._regression_or_discrete_prediction(
+                input_ids=input_ids,
+                attention_mask=attention_mask,
+                all_actions_mask=all_actions_mask,
+                action_head=action_head,
+                labels=labels,
+                action_dim=action_dim,
+                action_chunk=action_chunk,
+                vocab_size=vocab_size,
+                noisy_action_features=noisy_action_features,
+                ignore_end_tokens=2,
+                **kwargs
+            )
+
+
+        # Unnormalize predicted actions
+        actions = self._unnormalize_actions(normalized_actions, unnorm_key)
+
+        return actions
+
+
+    @staticmethod
+    def _check_unnorm_key(norm_stats: Dict[str, Dict[str, Any]], unnorm_key: Optional[str]) -> str:
+        if unnorm_key is None:
+            assert len(norm_stats) == 1, (
+                f"Your model was trained on more than one dataset, "
+                f"please pass a `unnorm_key` from the following options to choose the statistics "
+                f"used for un-normalizing actions: {norm_stats.keys()}"
+            )
+            unnorm_key = next(iter(norm_stats.keys()))
+
+        assert unnorm_key in norm_stats, (
+            f"The `unnorm_key` you chose is not in the set of available dataset statistics, "
+            f"please choose from: {norm_stats.keys()}"
+        )
+        return unnorm_key
+
+    def get_action_dim(self, unnorm_key: Optional[str] = None) -> int:
+        """Get the dimensionality of the policy's action space."""
+        unnorm_key = self._check_unnorm_key(self.norm_stats, unnorm_key)
+        return len(self.norm_stats[unnorm_key]["action"]["q01"])
+
+    def get_action_stats(self, unnorm_key: Optional[str] = None) -> Dict[str, Any]:
+        """Get all the logged statistics for the given dataset."""
+        unnorm_key = self._check_unnorm_key(self.norm_stats, unnorm_key)
+        return self.norm_stats[unnorm_key]["action"]
+
+    def _unnormalize_actions(self, normalized_actions, unnorm_key=None):
+        """Unnormalize actions using dataset statistics"""
+        action_norm_stats = self.get_action_stats(unnorm_key)
+        mask = action_norm_stats.get("mask", np.ones_like(action_norm_stats["q01"], dtype=bool))
+        action_high, action_low = np.array(action_norm_stats["q99"]), np.array(action_norm_stats["q01"])
+
+        actions = np.where(
+            mask,
+            0.5 * (normalized_actions + 1) * (action_high - action_low + 1e-8) + action_low,
+            normalized_actions,
+        )
+
         return actions
