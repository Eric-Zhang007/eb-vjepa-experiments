-def init_module(
-    module_class: Type[nn.Module],
-    module_name: str,
-    cfg: FinetuneConfig,
-    device_id: int,
-    module_args: dict,
-    to_bf16: bool = False,
-    find_unused_params: bool = False,
-) -> DDP:
