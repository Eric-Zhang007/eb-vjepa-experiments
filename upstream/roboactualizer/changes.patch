+def episode_sums(task):
+    fp, encoder_sha, embed_dim = task
+    torch.set_num_threads(1)
+    payload = torch.load(fp, map_location="cpu", weights_only=False, mmap=True)
+    require_encoder_identity(payload, encoder_sha, fp)
+    z = payload["latents"]
+    if z.ndim != 3 or z.shape[-1] != embed_dim:
+        raise ValueError(f"Invalid latent tensor: {fp}")
+    flat = z.reshape(-1, embed_dim)
+    s = torch.zeros(embed_dim, dtype=torch.float64)
+    s2 = torch.zeros_like(s)
+    for chunk in flat.split(8192):
+        if not torch.isfinite(chunk).all():
+            raise ValueError(f"Nonfinite latent tensor: {fp}")
+        x = chunk.to(torch.float64)
+        s += x.sum(0)
+        s2 += x.square().sum(0)
+    return s.numpy(), s2.numpy(), flat.shape[0]
 
 
