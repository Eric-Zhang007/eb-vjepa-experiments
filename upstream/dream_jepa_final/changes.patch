-def process_action_masks(labels, action_dim=7):
-    """Helper to get action masks from labels"""
-    current_action_mask = get_current_action_mask(labels, action_dim=action_dim)
-    next_actions_mask = get_next_actions_mask(labels,  action_dim=action_dim)
-    all_actions_mask = current_action_mask | next_actions_mask  # (B, seq_len)
-    return all_actions_mask
