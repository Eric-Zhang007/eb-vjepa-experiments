+        self.fc1 = nn.Linear(in_features, swiglu_hidden_features)
+        self.fc2 = nn.Linear(in_features, swiglu_hidden_features)
+        self.act = act_layer()
+        self.fc3 = nn.Linear(swiglu_hidden_features, out_features)
